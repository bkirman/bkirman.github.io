---
layout: base.njk
---
<article id="single-page">
    <header>
    <h1>{{title}}</h1>
    </header>
    <section id="content">
    {{ content | safe }}
    </section>

<div id="bits">

{% for bit in collections.bits | reverse %}
    <div class="bit-box">
        <a href="{{ bit.url }}" title="{{bit.data.subtitle}}">
    <div class="bit-title">
        {{bit.data.title}} ({{bit.date.getFullYear()}}{{bit.data.until}})
    </div>
    <img src="{{bit.url}}images/{{bit.data.coverImage}}" width="300" alt="{{bit.data.title}}">
    <div class="bit-subtitle">
    {{bit.data.subtitle}}
    </div>
    </a>
    </div>
{% endfor %}
</div>
</article> 